      "title",
      "description",
      "status",
      "priority",
      "component",
      "milestone",
      "due_date",
      "estimate_min",
      "pinned",
      "archived",
      "checklist",
      "labels",
      "dependencies",
      "parent_id",
      "created_at",
      "completed_at"
    ],
    "json": [
      "checklist"
    ],
    "virtual": [
      "labels",
      "dependencies"
    ],
    "defaults": {
      "project_id": "",
      "title": "",
      "description": "",
      "status": "inbox",
      "priority": "medium",
      "component": "",
      "milestone": "",
      "due_date": "",
      "estimate_min": 0,
      "pinned": 0,
      "archived": 0,
      "checklist": [],
      "labels": [],
      "dependencies": [],
      "parent_id": "",
      "created_at": 0,
      "completed_at": 0
    }
  },
  "event": {
    "table": "events",
    "fields": [
      "title",
      "date",
      "start_time",
      "end_time",
      "major",
      "pinned",
      "event_type",
      "end_date",
      "description",
      "location",
      "color",
      "recurrence",
      "archived"
