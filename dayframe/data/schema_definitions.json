{
  "project": {
    "table": "projects",
    "fields": [
      "name",
      "project_key",
      "description",
      "archived"
    ],
    "defaults": {
      "name": "",
      "project_key": "PROJ",
      "description": "",
      "archived": 0
    }
  },
  "ticket": {
    "table": "tickets",
    "fields": [
