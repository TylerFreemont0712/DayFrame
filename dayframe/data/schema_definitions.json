    "defaults": {
      "title": "",
      "date": "",
      "start_time": "09:00",
      "end_time": "10:00",
      "major": 0,
      "pinned": 0,
      "event_type": "event",
      "end_date": "",
      "description": "",
      "location": "",
      "color": "",
      "recurrence": "",
      "archived": 0
    }
  },
  "note": {
    "table": "notes",
    "fields": [
      "title",
